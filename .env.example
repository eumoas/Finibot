# === TELEGRAM ===
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_SECRET_TOKEN=generate_a_random_secret_here

# === LLM (qualquer API OpenAI-compatible: xAI, Groq, OpenRouter...) ===
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.x.ai/v1/chat/completions
LLM_MODEL=grok-3-mini
# Para usar Groq em vez de xAI:
# LLM_BASE_URL=https://api.groq.com/openai/v1/chat/completions
# LLM_MODEL=llama-3.3-70b-versatile

# === OLLAMA (fallback local) ===
OLLAMA_BASE_URL=http://ollama:11434

# === DATABASE ===
DATABASE_URL=postgresql+asyncpg://fini:finidev123@postgres:5432/finibot
POSTGRES_PASSWORD=finidev123

# === REDIS ===
REDIS_URL=redis://redis:6379/0

# === APP ===
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
ADMIN_API_KEY=change_me_in_production_please

# === LIMITES ===
MAX_MESSAGES_PER_HOUR=30
CONTEXT_WINDOW_SIZE=10
MAX_TOKENS_RESPONSE=350
